# Dewey with Docker Compose. Copy this file to .env (same folder) and fill it in. .env is git-ignored: it holds your password.
# Docker Compose reads it by itself. One KEY=value per line, no quotes.

# --- where things are (required) ----------------------------------------------------------------------------
# The folder that CONTAINS your Music folder (so it contains Music/). Dewey also uses _incoming, _reorg and
# _dedupe-quarantine next to Music; it creates them when the first writing service starts.
DEWEY_MEDIA=/srv/media
# The folder that holds Navidrome's navidrome.db (mounted read-only). Dewey needs it to protect what you play, star and put in playlists.
DEWEY_NAVIDROME_DATA=/srv/navidrome/data

# --- who runs it ----------------------------------------------------------------------------------------------
# Run Dewey as the user that owns your music files (on Linux:  id -u  and  id -g  as that user).
# Wrong numbers show up as "permission denied" on the first real run; nothing is changed.
DEWEY_UID=1000
DEWEY_GID=1000
# Time zone for run names and logs, e.g. America/New_York
DEWEY_TZ=UTC

# --- the web console (required: it will not start without a password) -------------------------------------------
MD_WEB_USER=admin
# a long random password, from your password manager
MD_WEB_PASS=
# One login per person: more pairs, numbered _2 and _3. The History then shows who started each job.
# MD_WEB_USER_2=
# MD_WEB_PASS_2=

# 127.0.0.1 = reachable from this computer only (the safe default). To reach the console from other devices, put HTTPS in front of it
# (a reverse proxy, Tailscale Serve, ...) and keep this at 127.0.0.1. Never publish it on the internet.
DEWEY_WEB_BIND=127.0.0.1
DEWEY_WEB_PORT=8099
# Only answer to these host names (comma separated), e.g. dewey.example.net. The Security page shows the name your browser used.
# MD_WEB_HOSTS=

# --- real runs (the runner) ---------------------------------------------------------------------------------------
# How many minutes arming lasts (1 to 120).
# MD_ARM_MINUTES=15
# The name your authenticator app shows for Dewey.
# DEWEY_LABEL=console

# --- optional pieces ----------------------------------------------------------------------------------------------
# Beets: see compose.beets.yml
# DEWEY_BEETS=/srv/beets
# COMPOSE_FILE=docker-compose.yml:compose.beets.yml
# A token that may read GET /api/widget (a dozen counts, for a dashboard tile). At least 24 characters:  openssl rand -hex 16
# MD_WIDGET_TOKEN=
# Where Dewey keeps its reports and settings (default ./data): data/out (reports, plans, logs), data/config (rules.txt, navidrome.cred)
# Create both folders before the first start:  mkdir -p data/out data/config   (Synology's Docker does not create missing folders)
# DEWEY_DATA=./data
